pkgbase = twitty-git
	pkgdesc = Native GPU-rendered terminal built for Arabic and bidirectional text (git)
	pkgver = 4.0.0
	pkgrel = 1
	url = https://github.com/omarallsharkawy/RTL-Terminal
	arch = x86_64
	arch = aarch64
	license = AGPL-3.0-or-later
	makedepends = cargo
	makedepends = git
	depends = dbus
	depends = gcc-libs
	depends = glibc
	depends = hicolor-icon-theme
	depends = libx11
	depends = libxcb
	depends = libxcursor
	depends = libxi
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = mesa
	depends = vulkan-icd-loader
	depends = wayland
	optdepends = libnotify: desktop notifications via notify-send
	optdepends = openssh: persistent SSH tabs (twitty ssh)
	optdepends = vulkan-driver: hardware-accelerated Vulkan rendering
	provides = twitty
	conflicts = twitty
	conflicts = twitty-bin
	options = !lto
	source = twitty-git::git+https://github.com/omarallsharkawy/RTL-Terminal.git
	sha256sums = SKIP

pkgname = twitty-git
